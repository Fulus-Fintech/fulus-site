{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fulus-site",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-03",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Without this, Cloudflare serves static-asset matches (e.g. "/") directly
    // from the Asset Worker and never invokes src/worker.ts — so the
    // data-doors stamp (job 2, spec §6) would silently never apply on a real
    // page load. Routing every request through the User Worker first keeps
    // env.ASSETS.fetch() as the fallback path already written in the fetch handler.
    "run_worker_first": true
  },
  // Doors flip = change DOORS to "open" (one var). Store IDs are founder
  // open items (spec §10.1) — empty until the listings exist; redirects ship
  // against the vars either way.
  "vars": {
    "DOORS": "pre",
    "APP_STORE_ID": "",
    "PLAY_PACKAGE_ID": ""
  },
  "analytics_engine_datasets": [
    { "binding": "EVENTS", "dataset": "fulus_site_events" }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
